# Supabase — find these in your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side only. Used by the lead-capture API route to insert rows.
# Settings → API → service_role key. NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Meta / Facebook Pixel ID (Events Manager → Data Sources → your pixel)
# Leave blank to disable pixel loading.
NEXT_PUBLIC_META_PIXEL_ID=

# Used in metadata / canonical URLs. Set to your production domain on Vercel.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- Whop checkout / one-click upsell ---
# Public plan id for the $47 AI Assistant Blueprint checkout embed.
NEXT_PUBLIC_WHOP_ASSISTANT_PLAN_ID=plan_5o9mIASo2qceZ

# Server-side ONLY (never NEXT_PUBLIC). Owner-level Whop API key with the
# payment:charge permission — used by /api/upsell-charge to charge the saved
# card for the one-click $2,997 upsell. Generate in Whop → Settings → API
# from an Owner account.
WHOP_API_KEY=

# Whop company id (biz_xxx). Defaults to AI Scaling Co in code.
WHOP_COMPANY_ID=biz_FfA6Ya2QrJqzLa

# plan_xxx for the $2,997 Done-For-You setup. Create it in the Whop dashboard
# as a one-time plan, then paste the id here. Used by both the upsell charge
# route and the webhook → Beehiiv "dfy_setup" tag.
WHOP_DFY_PLAN_ID=

# Beehiiv (post-purchase tagging → email automations)
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=pub_5f264154-9cc1-43cc-b172-d16b4f73b38b

# Whop webhook signing secret (Whop → Settings → Webhooks). Optional but
# recommended — verifies inbound webhook authenticity.
WHOP_WEBHOOK_SECRET=
