# Supabase — find these in your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side only. Used by the lead-capture API route to insert rows.
# Settings → API → service_role key. NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Meta / Facebook Pixel ID (Events Manager → Data Sources → your pixel)
# Leave blank to disable pixel loading.
NEXT_PUBLIC_META_PIXEL_ID=

# Used in metadata / canonical URLs. Set to your production domain on Vercel.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
